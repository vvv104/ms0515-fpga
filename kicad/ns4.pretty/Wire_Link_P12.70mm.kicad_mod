	(property "Value" "Wire_Link_P12.70mm" (at 0.950 1.800 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(attr through_hole)
	(fp_rect (start 0.950 -0.300) (end 11.750 0.300) (stroke (width 0.12) (type solid)) (fill no) (layer "F.SilkS"))
	(pad "1" thru_hole circle (at 0.000 0.000) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole circle (at 12.700 0.000) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/ns4.3dshapes/Wire_Link_P12.70mm.wrl" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
